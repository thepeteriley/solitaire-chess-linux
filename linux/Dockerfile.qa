ARG BASE_IMAGE=debian:13-slim
FROM ${BASE_IMAGE}
ARG DEB_FILE
COPY ${DEB_FILE} /tmp/solitaire-chess.deb
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y /tmp/solitaire-chess.deb xvfb xauth dbus-x11 nodejs desktop-file-utils && rm -rf /var/lib/apt/lists/* /tmp/solitaire-chess.deb
RUN desktop-file-validate /usr/share/applications/com.peteriley.solitairechess.desktop && useradd -m chess
USER chess
WORKDIR /work
ENV SOLITAIRE_PACKAGED_APP=/opt/solitaire-chess/solitaire-chess
CMD ["xvfb-run", "-a", "-s", "-screen 0 1440x1100x24", "dbus-run-session", "--", "node", "scripts/smoke.mjs"]
